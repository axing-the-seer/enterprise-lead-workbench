{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "../..",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../../src/domain/**/*.ts",
    "../../src/providers/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
